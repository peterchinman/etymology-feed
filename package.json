{
  "name": "etymology-feed",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build:web": "npm run build -w @etymology-feed/web",
    "lint": "biome check apps/api/src apps/api/test apps/api/vitest.config.ts apps/web/astro.config.mjs packages/shared",
    "test:api": "npm run test -w @etymology-feed/api",
    "test:shared": "vitest run packages/shared",
    "typecheck:api": "tsc --project apps/api/tsconfig.json",
    "typecheck:shared": "tsc --project packages/shared/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "wrangler": "4.141.0",
    "miniflare": "5.20260925.0-alpha"
  }
}
