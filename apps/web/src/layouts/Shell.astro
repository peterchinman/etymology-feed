---
import '../styles/global.css';
import SettingsDialog from '../components/SettingsDialog';
import { DEFAULT_THEME, THEME_COLORS, THEMES } from '../lib/themes';
import { ClientRouter } from 'astro:transitions';
import modernFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import sansMediumFont from '@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';
import sansRegularFont from '@fontsource/instrument-sans/files/instrument-sans-latin-400-normal.woff2?url';
import romanticHeadingFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import technicalLabelFont from '@fontsource/b612-mono/files/b612-mono-latin-400-normal.woff2?url';
import technicalHeadingFont from '@fontsource/b612-mono/files/b612-mono-latin-700-normal.woff2?url';
import technicalBodyFont from '@fontsource/b612/files/b612-latin-400-normal.woff2?url';

type Props = { title: string; page: 'feed' | 'liked' | 'settings' };
const { title, page } = Astro.props;
const themeIds = THEMES.map((option) => option.id);
const settingsFonts =
  page === 'settings'
    ? {
        gallery: [modernFont, sansMediumFont, sansRegularFont],
        nocturne: [sansMediumFont, sansRegularFont, romanticHeadingFont],
        indigo: [technicalLabelFont, technicalHeadingFont, technicalBodyFont],
      }
    : null;
---
<!doctype html>
<html lang="en" class={`${DEFAULT_THEME} light`} transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLORS[DEFAULT_THEME].light} />
    <meta name="description" content="Discover the stories inside words, one card at a time." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/word-roots.svg" type="image/svg+xml" />
    <title>{title} · Etymology Feed</title>
    <ClientRouter fallback="swap" />
    <script
      define:vars={{ themeIds, colors: THEME_COLORS, fallback: DEFAULT_THEME, settingsFonts }}
    >
      (() => {
        let theme = fallback;
        let mode = 'system';
        try {
          const storedTheme = localStorage.getItem('etymology-theme');
          if (themeIds.includes(storedTheme)) theme = storedTheme;
          // Before the theme picker, etymology-theme held the light/dark choice.
          mode = localStorage.getItem('etymology-color-mode')
            || (storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'system');
        } catch {
          // Use the device preference when localStorage is unavailable.
        }
        const root = document.documentElement;
        if (settingsFonts) {
          for (const href of settingsFonts[theme]) {
            const preload = document.createElement('link');
            preload.rel = 'preload';
            preload.as = 'font';
            preload.type = 'font/woff2';
            preload.crossOrigin = 'anonymous';
            preload.href = href;
            document.head.append(preload);
          }
        }
        const systemDark = matchMedia('(prefers-color-scheme: dark)');
        root.dataset.colorMode = mode;
        const apply = () => {
          const dark = mode === 'dark' || (mode !== 'light' && systemDark.matches);
          root.classList.remove(...themeIds, 'light', 'dark');
          root.classList.add(theme, dark ? 'dark' : 'light');
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', colors[theme][dark ? 'dark' : 'light']);
        };
        apply();
        if (!window.__etymologyThemeNavigation) {
          window.__etymologyThemeNavigation = true;
          document.addEventListener('astro:before-swap', (event) => {
            const current = document.documentElement;
            const incoming = event.newDocument.documentElement;
            incoming.className = current.className;
            incoming.dataset.colorMode = current.dataset.colorMode;
            event.newDocument.querySelector('meta[name="theme-color"]')
              ?.setAttribute('content', document.querySelector('meta[name="theme-color"]')?.content || '');
          });
          systemDark.addEventListener('change', () => {
            if (root.dataset.colorMode !== 'system') return;
            mode = 'system';
            theme = themeIds.find((id) => root.classList.contains(id)) || fallback;
            apply();
          });
        }
      })();
    </script>
  </head>
  <body class="body-voice">
    <div class="site-shell">
      <header class="topbar">
        <a class="brand label-voice" href="/" aria-label="Etymology Feed home" transition:persist>
          <span>Etymology Feed</span>
        </a>
        <nav class="top-nav label-voice" aria-label="Main navigation">
          <a href="/" aria-current={page === 'feed' ? 'page' : undefined}>Feed</a>
          <a href="/liked/" aria-current={page === 'liked' ? 'page' : undefined}>Liked</a>
          <a href="/settings/" data-settings-dialog-trigger aria-current={page === 'settings' ? 'page' : undefined}>Settings</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
    </div>
    <nav class="bottom-nav label-voice" aria-label="Main navigation">
      <a href="/" aria-current={page === 'feed' ? 'page' : undefined}>
        <svg aria-hidden="true" viewBox="0 0 256 256" fill="none">
          <rect x="40" y="32" width="176" height="192" rx="20" stroke="currentColor" stroke-width="16" />
          <path d="M76 88h104M76 128h104M76 168h64" stroke="currentColor" stroke-linecap="round" stroke-width="16" />
        </svg>
        <span class="nav-label">Feed</span>
      </a>
      <a href="/liked/" aria-current={page === 'liked' ? 'page' : undefined}>
        <svg class="heart-icon" aria-hidden="true" viewBox="0 0 256 256">
          <rect width="256" height="256" fill="none" />
          <path d="M128,224l89.36-90.64a50,50,0,1,0-70.72-70.72L128,80,109.36,62.64a50,50,0,0,0-70.72,70.72Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
        </svg>
        <span class="nav-label">Liked</span>
      </a>
      <a href="/settings/" aria-current={page === 'settings' ? 'page' : undefined}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M10.3 2h3.4l.55 2.15c.58.16 1.14.39 1.66.69l1.91-1.13 2.4 2.4-1.13 1.91c.3.52.53 1.08.69 1.66L22 10.3v3.4l-2.15.55a8.1 8.1 0 0 1-.69 1.66l1.13 1.91-2.4 2.4-1.91-1.13a8.1 8.1 0 0 1-1.66.69L13.7 22h-3.4l-.55-2.15a8.1 8.1 0 0 1-1.66-.69l-1.91 1.13-2.4-2.4 1.13-1.91a8.1 8.1 0 0 1-.69-1.66L2 13.7v-3.4l2.15-.55c.16-.58.39-1.14.69-1.66L3.71 6.18l2.4-2.4 1.91 1.13c.52-.3 1.08-.53 1.66-.69L10.3 2Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5" />
          <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <span class="nav-label">Settings</span>
      </a>
    </nav>
    {page !== 'settings' && <SettingsDialog client:load />}
    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(console.error);
        });
      }
    </script>
  </body>
</html>
