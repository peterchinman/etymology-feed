---
import '../styles/global.css';

type Props = { title: string; page: 'feed' | 'liked' };
const { title, page } = Astro.props;
---
<!doctype html>
<html lang="en" class="pink light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F7EBE4" />
    <meta name="description" content="Discover the stories inside words, one card at a time." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <title>{title} · Etymology Feed</title>
    <script is:inline>
      (() => {
        let palette = 'pink';
        let mode = 'system';
        try {
          if (localStorage.getItem('etymology-palette') === 'blue') palette = 'blue';
          mode = localStorage.getItem('etymology-color-mode') || localStorage.getItem('etymology-theme') || 'system';
        } catch {
          // Use the device preference when localStorage is unavailable.
        }
        const root = document.documentElement;
        const systemDark = matchMedia('(prefers-color-scheme: dark)');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        root.dataset.colorMode = mode;
        const apply = () => {
          const dark = mode === 'dark' || (mode !== 'light' && systemDark.matches);
          root.classList.remove('pink', 'blue', 'light', 'dark');
          root.classList.add(palette, dark ? 'dark' : 'light');
          themeColor?.setAttribute('content', palette === 'blue'
            ? (dark ? '#0F1436' : '#E0E1F7')
            : (dark ? '#25141B' : '#F7EBE4'));
        };
        apply();
        systemDark.addEventListener('change', () => {
          if (root.dataset.colorMode !== 'system') return;
          mode = 'system';
          palette = root.classList.contains('blue') ? 'blue' : 'pink';
          apply();
        });
      })();
    </script>
  </head>
  <body class="body-voice">
    <div class="site-shell">
      <header class="topbar">
        <a class="brand label-voice" href="/" aria-label="Etymology Feed home">
          <span>Etymology Feed</span>
        </a>
        <nav class="top-nav label-voice" aria-label="Main navigation">
          <a href="/" aria-current={page === 'feed' ? 'page' : undefined}>Feed</a>
          <a href="/liked/" aria-current={page === 'liked' ? 'page' : undefined}>Liked</a>
          <a href="/?settings=1">Settings</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
    </div>
    <nav class="bottom-nav label-voice" aria-label="Main navigation">
      <a href="/" aria-current={page === 'feed' ? 'page' : undefined}><span aria-hidden="true">▤</span>Feed</a>
      <a href="/liked/" aria-current={page === 'liked' ? 'page' : undefined}>
        <svg class="heart-icon" aria-hidden="true" viewBox="0 0 256 256">
          <rect width="256" height="256" fill="none" />
          <path d="M128,224l89.36-90.64a50,50,0,1,0-70.72-70.72L128,80,109.36,62.64a50,50,0,0,0-70.72,70.72Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16" />
        </svg>
        Liked
      </a>
      <a href="/?settings=1"><span aria-hidden="true">⚙</span>Settings</a>
    </nav>
    <script>
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(console.error);
        });
      }
    </script>
  </body>
</html>
